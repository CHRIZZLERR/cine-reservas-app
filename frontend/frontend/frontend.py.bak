            rx.text(p["fecha_estreno"], class_name="card-fecha"),
            rx.text(p["titulo"], class_name="card-title"),
            rx.text(p["genero"], class_name="card-genre"),
            rx.button(
                "Más Información",
                class_name="btn-card-outline",
