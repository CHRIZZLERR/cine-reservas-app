# ═══════════════════════════════════════════════════════════════
#  BOOKING PAGE
# ═══════════════════════════════════════════════════════════════

def booking_navbar() -> rx.Component:
    return rx.box(
        rx.hstack(
            rx.button("← Volver", class_name="back-btn", on_click=State.go_back_to_movie),
            rx.spacer(),
            rx.hstack(
                rx.text("🎬", font_size="20px"),
                rx.text("CineMax", class_name="logo-text"),
                spacing="2", align="center",
            ),
            rx.spacer(),
            rx.button("✕", class_name="close-btn", on_click=State.go_home),
            align="center",
            width="100%",
        ),
        class_name="booking-navbar",
    )


def progress_step(num: int, label: str) -> rx.Component:
    done = State.booking_step > num
    active = State.booking_step == num
    return rx.hstack(
        rx.box(
            rx.cond(done, rx.text("✓", font_size="14px"), rx.text(str(num), font_size="14px")),
            class_name=rx.cond(
                done, "step-circle step-done",
                rx.cond(active, "step-circle step-active", "step-circle")
            ),
            on_click=State.go_step(num),
            cursor="pointer",
        ),
        rx.text(
            label,
            class_name=rx.cond(
                active, "step-label step-label-active", "step-label"
            ),
        ),
        spacing="2",
        align="center",
    )


def progress_bar() -> rx.Component:
    steps = [(1, "Asientos"), (2, "Comida y bebida"), (3, "Carrito"), (4, "Pago")]
    return rx.box(
        rx.hstack(
            *[
                rx.fragment(
                    progress_step(num, label),
                    rx.box(
                        class_name=rx.cond(
                            State.booking_step > num,
                            "step-connector step-connector-done",
                            "step-connector",
                        ),
                    ) if num < 4 else rx.fragment(),
                )
                for num, label in steps
            ],
            align="center",
            spacing="0",
            justify="center",
            width="100%",
        ),
        class_name="progress-bar",
    )


# ── Step 1: Seat Map ──────────────────────────────────────────
def seat_btn(seat: dict) -> rx.Component:
    return rx.box(
        class_name=rx.cond(
            seat["estado"] == "reservado",
            "seat seat-reserved",
            rx.cond(
                State.selected_seats.contains(seat["id"]),
                rx.cond(seat["tipo"] == "vip", "seat seat-vip seat-selected", "seat seat-selected"),
                rx.cond(seat["tipo"] == "vip", "seat seat-vip", "seat seat-available"),
            ),
        ),
        on_click=State.toggle_seat(seat["id"]),
        title=seat["id"],
    )


def seat_row_render(row_letter: str, row_var) -> rx.Component:
    return rx.hstack(
        rx.box(row_letter, class_name="row-lbl"),
        rx.box(
            rx.foreach(row_var, seat_btn),
            class_name="seats-inner",
        ),
        rx.box(row_letter, class_name="row-lbl"),
        gap="6px",
        align="center",
    )


def seat_map_section() -> rx.Component:
    row_data = [
        ("A", State.row_A), ("B", State.row_B), ("C", State.row_C), ("D", State.row_D),
        ("E", State.row_E), ("F", State.row_F), ("G", State.row_G), ("H", State.row_H),
        ("I", State.row_I), ("J", State.row_J), ("K", State.row_K), ("L", State.row_L),
    ]
    vip_rows = [("M", State.row_M), ("N", State.row_N)]

    return rx.vstack(
        # Screen
        rx.box(
            rx.box(class_name="screen-arc"),
            rx.text("PANTALLA", class_name="screen-text"),
            class_name="screen-wrap",
            margin_bottom="20px",
        ),
        # Regular rows
        *[seat_row_render(r, var) for r, var in row_data],
        # VIP divider
        rx.hstack(
            rx.box(class_name="vip-divider-line"),
            rx.text("♛  ZONA VIP  ♛", class_name="vip-divider-text"),
            rx.box(class_name="vip-divider-line"),
            align="center",
            width="100%",
            margin_y="12px",
        ),
        # VIP rows
        *[seat_row_render(r, var) for r, var in vip_rows],
        # Legend
        rx.hstack(
            rx.hstack(rx.box(class_name="legend-dot leg-available"), rx.text("Disponible", class_name="leg-text"), spacing="2"),
            rx.hstack(rx.box(class_name="legend-dot leg-selected"), rx.text("Seleccionado", class_name="leg-text"), spacing="2"),
            rx.hstack(rx.box(class_name="legend-dot leg-reserved"), rx.text("Reservado", class_name="leg-text"), spacing="2"),
            rx.hstack(rx.box(class_name="legend-dot leg-vip"), rx.text("VIP", class_name="leg-text"), spacing="2"),
            spacing="6",
            justify="center",
            margin_top="16px",
        ),
        align="center",
        spacing="1",
        class_name="seat-map-wrap",
    )


# ── Step 2: Food & Drinks ─────────────────────────────────────
def food_card(item: dict) -> rx.Component:
    return rx.box(
        rx.text(item["emoji"], class_name="food-emoji"),
        rx.text(item["nombre"], class_name="food-name"),
        rx.text(item["descripcion"], class_name="food-desc"),
        rx.text(f"RD${item['precio']}", class_name="food-price"),
        rx.hstack(
            rx.button("−", class_name="qty-btn", on_click=State.remove_food(item["id"])),
            rx.text(item["qty"], class_name="qty-num"),
            rx.button("+", class_name="qty-btn qty-btn-add", on_click=State.add_food(item["id"])),
            spacing="3", align="center", justify="center",
        ),
        class_name="food-card",
    )


def food_section() -> rx.Component:
    return rx.vstack(
        rx.heading("Comida y Bebida", class_name="booking-section-title"),
        rx.text("Añade snacks y bebidas a tu pedido (opcional)", class_name="booking-section-sub"),
        rx.grid(
            rx.foreach(State.food_cart, food_card),
            columns="3",
            spacing="4",
            width="100%",
        ),
        align_items="start",
        spacing="5",
        width="100%",
    )


# ── Step 3: Cart ──────────────────────────────────────────────
def cart_section() -> rx.Component:
    return rx.vstack(
        rx.heading("Carrito", class_name="booking-section-title"),
        # Tickets card
        rx.box(
            rx.hstack(
                rx.text("🎟️  Boletos", class_name="cart-card-title"),
                rx.spacer(),
                rx.text(
                    f"{State.num_asientos} boleto{'s' if State.num_asientos != 1 else ''} · RD${State.total_boletos}",
                    class_name="cart-card-total",
                ),
                align="center",
            ),
            rx.box(
                rx.hstack(
                    rx.text(State.cm_titulo, class_name="cart-item-title"),
                    rx.spacer(),
                    rx.text(State.selected_showtime, class_name="cart-item-meta"),
                    align="center",
                ),
                rx.hstack(
                    rx.text(
                        f"📍 {State.selected_location}",
                        class_name="cart-item-meta",
                    ),
                    rx.spacer(),
                    rx.text(State.asientos_display, class_name="cart-item-meta"),
                    align="center",
                    margin_top="6px",
                ),
                class_name="cart-item-box",
            ),
            class_name="cart-card",
        ),
        # Food card (if any)
        rx.cond(
            State.total_comida > 0,
            rx.box(
                rx.hstack(
                    rx.text("🍿  Comida y Bebida", class_name="cart-card-title"),
                    rx.spacer(),
                    rx.text(f"RD${State.total_comida}", class_name="cart-card-total"),
                    align="center",
                ),
                rx.foreach(
                    State.food_selected,
                    lambda item: rx.hstack(
                        rx.text(item["emoji"], font_size="16px"),
                        rx.text(item["nombre"], class_name="cart-food-name"),
                        rx.text(f"×{item['qty']}", class_name="cart-item-meta"),
                        rx.spacer(),
                        rx.text(f"RD${item['precio'] * item['qty']}", class_name="cart-item-meta"),
                        spacing="2",
                        align="center",
                        padding_y="6px",
                        border_bottom="1px solid rgba(255,255,255,0.05)",
                    ),
                ),
                class_name="cart-card",
                margin_top="0",
            ),
            rx.box(),
        ),
        # Promo code
        rx.box(
            rx.hstack(
                rx.input(placeholder="Añadir tarjeta de regalo, cupón, código promocional", class_name="promo-input"),
                rx.button("APLICAR", class_name="btn-red-sm"),
                spacing="3",
                width="100%",
            ),
            class_name="cart-card",
        ),
        align_items="start",
        spacing="4",
        width="100%",
    )


# ── Step 4: Payment ───────────────────────────────────────────
def payment_section() -> rx.Component:
    return rx.vstack(
        rx.heading("Pago", class_name="booking-section-title"),
        rx.box(
            rx.text("Información de Tarjeta", class_name="pay-group-title"),
            rx.grid(
                rx.vstack(
                    rx.text("Nombre en la tarjeta", class_name="pay-label"),
                    rx.input(
                        placeholder="Nombre completo",
                        class_name="pay-input",
                        value=State.card_name,
                        on_change=State.set_card_name,
                    ),
                    align_items="start", spacing="1",
                ),
                rx.vstack(
                    rx.text("Número de tarjeta", class_name="pay-label"),
                    rx.input(
                        placeholder="0000  0000  0000  0000",
                        class_name="pay-input",
                        value=State.card_number,
                        on_change=State.set_card_number,
                    ),
                    align_items="start", spacing="1",
                ),
                rx.vstack(
                    rx.text("Fecha de expiración", class_name="pay-label"),
                    rx.input(
                        placeholder="MM / AA",
                        class_name="pay-input",
                        value=State.card_expiry,
                        on_change=State.set_card_expiry,
                    ),
                    align_items="start", spacing="1",
                ),
                rx.vstack(
                    rx.text("CVV", class_name="pay-label"),
                    rx.input(
                        placeholder="•••",
                        class_name="pay-input",
                        value=State.card_cvv,
                        on_change=State.set_card_cvv,
                    ),
                    align_items="start", spacing="1",
                ),
                columns="2",
                spacing="4",
                width="100%",
            ),
            rx.hstack(
                rx.text("🔒", font_size="14px"),
                rx.text("Tu información está protegida con cifrado SSL de 256 bits.", class_name="pay-security"),
                spacing="2",
                align="center",
                margin_top="12px",
            ),
            class_name="pay-card",
        ),
        align_items="start",
        spacing="4",
        width="100%",
    )


# ── Step 5: Success Screen ────────────────────────────────────
def success_section() -> rx.Component:
    return rx.vstack(
        rx.text("🎉", font_size="72px"),
        rx.heading("¡Reserva Confirmada!", class_name="success-title"),
        rx.text("Tu código de reserva es:", class_name="success-sub"),
        rx.box(
            rx.text(State.reservation_code, class_name="reservation-code"),
            class_name="code-box",
        ),
        rx.text(
            "Presentar este código (o tu ID) en taquilla. ¡Disfruta la función!",
            class_name="success-note",
        ),
        rx.button("Volver al Inicio", class_name="btn-primary-lg", on_click=State.go_home),
        align="center",
        spacing="5",
        padding_y="60px",
    )


# ── Order Sidebar ─────────────────────────────────────────────
def order_sidebar() -> rx.Component:
    return rx.box(
        # Movie info
        rx.hstack(
            rx.box(
                rx.box(style={"background": State.cm_bg}, class_name="sidebar-poster-bg"),
                rx.text(State.cm_emoji, class_name="sidebar-emoji"),
                class_name="sidebar-poster",
            ),
            rx.vstack(
                rx.text(State.cm_titulo, class_name="sidebar-movie-title"),
                rx.text(State.selected_showtime, class_name="sidebar-showtime"),
                rx.text(f"📍 {State.selected_location}", class_name="sidebar-location"),
                align_items="start",
                spacing="1",
            ),
            spacing="3",
            align="start",
            margin_bottom="20px",
        ),
        rx.box(class_name="sidebar-divider"),
        # Boletos
        rx.hstack(
            rx.text("Boletos", class_name="sidebar-label"),
            rx.spacer(),
            rx.text(f"{State.num_asientos}  ·  RD${State.total_boletos}", class_name="sidebar-value"),
            align="center",
            margin_y="8px",
        ),
        # Asientos
        rx.hstack(
            rx.text("Asientos", class_name="sidebar-label"),
            rx.spacer(),
            rx.text(State.asientos_display, class_name="sidebar-value sidebar-seats"),
            align="center",
            margin_bottom="8px",
        ),
        # Food
        rx.cond(
            State.total_comida > 0,
            rx.hstack(
                rx.text("Comida", class_name="sidebar-label"),
                rx.spacer(),
                rx.text(f"RD${State.total_comida}", class_name="sidebar-value"),
                align="center",
                margin_bottom="8px",
            ),
            rx.box(),
        ),
        # Service fee
        rx.hstack(
            rx.text("Cargo por servicio", class_name="sidebar-label sidebar-fee"),
            rx.spacer(),
            rx.text(f"RD${State.cargo_servicio}", class_name="sidebar-value sidebar-fee"),
            align="center",
            margin_bottom="16px",
        ),
        rx.box(class_name="sidebar-divider"),
        # Total
        rx.hstack(
            rx.text("Total", class_name="sidebar-total-label"),
            rx.spacer(),
            rx.text(f"RD${State.gran_total}", class_name="sidebar-total-value"),
            align="center",
            margin_top="12px",
        ),
        class_name="order-sidebar",
    )


def booking_page() -> rx.Component:
    return rx.box(
        page_style(),
        booking_navbar(),
        progress_bar(),
        rx.cond(
            State.booking_step == 5,
            # Success screen
            rx.box(
                success_section(),
                class_name="booking-success",
            ),
            # Normal booking flow
            rx.hstack(
                # Left: step content
                rx.box(
                    rx.cond(
                        State.booking_step == 1,
                        seat_map_section(),
                        rx.cond(
                            State.booking_step == 2,
                            food_section(),
                            rx.cond(
                                State.booking_step == 3,
                                cart_section(),
                                payment_section(),
                            ),
                        ),
                    ),
                    class_name="booking-main",
                    flex="1",
                ),
                # Right: sidebar
                order_sidebar(),
                align="start",
                spacing="0",
                width="100%",
            ),
        ),
        # Bottom action bar
        rx.cond(
            State.booking_step < 5,
            rx.box(
                rx.hstack(
                    rx.cond(
                        State.booking_step > 1,
                        rx.button("← Anterior", class_name="btn-ghost", on_click=State.prev_step),
                        rx.box(),
                    ),
                    rx.spacer(),
                    rx.cond(
                        State.booking_step == 4,
                        rx.button(
                            f"SIGUIENTE: PAGO  →  RD${State.gran_total}",
                            class_name="btn-book-confirm",
                            on_click=State.confirm_payment,
                        ),
                        rx.button(
                            rx.cond(
                                State.booking_step == 1,
                                "SIGUIENTE: COMIDA Y BEBIDA  →",
                                rx.cond(
                                    State.booking_step == 2,
                                    "SIGUIENTE: CARRITO  →",
                                    "SIGUIENTE: PAGO  →",
                                ),
                            ),
                            class_name="btn-book-next",
                            on_click=State.next_step,
                        ),
                    ),
                    align="center",
                    width="100%",
                ),
                class_name="booking-footer-bar",
            ),
            rx.box(),
        ),
        class_name="booking-page",
    )


# ═══════════════════════════════════════════════════════════════
#  APP SETUP
# ═══════════════════════════════════════════════════════════════
app = rx.App(stylesheets=["/style.css"])
app.add_page(home_page, route="/")
app.add_page(movie_page, route="/pelicula")
app.add_page(booking_page, route="/reservar")