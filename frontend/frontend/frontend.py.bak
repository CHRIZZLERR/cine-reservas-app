def coming_soon_section() -> rx.Component:
    pronto = [p for p in PELICULAS if p["tab"] == "pronto"]
    return rx.box(
        rx.box(
            rx.hstack(
                rx.heading("Próximamente", class_name="section-title"),
                rx.spacer(),
                rx.link("Ver Todas →", href="#", class_name="view-all"),
                align="center",
                margin_bottom="24px",
            ),
            rx.box(
                *[coming_strip_card(p) for p in pronto],
                class_name="strip-scroll",
            ),
            class_name="section",
        ),
        background="#131318",
        border_top="1px solid rgba(200,16,46,0.12)",
        border_bottom="1px solid rgba(200,16,46,0.12)",
    )


