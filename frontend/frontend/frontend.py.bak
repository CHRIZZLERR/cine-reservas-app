def _gen_seats() -> list[dict]:
    reserved = {"B5", "B6", "C3", "D10", "D11", "F7", "F8", "H4", "H5", "H6", "J12", "K9", "L2"}
    seats = []
    for row in SEAT_ROWS:
        for col in range(1, 16):
            sid = f"{row}{col}"
            seats.append({
                "id": sid, "row": row, "col": col,
                "tipo": "vip" if row in "MN" else "regular",
                "estado": "reservado" if sid in reserved else "disponible",
            })
    return seats


INIT_SEATS = _gen_seats()


# ─── State ────────────────────────────────────────────────────
class State(rx.State):
    hero_index: int = 0
    active_tab: str = "cartelera"
    movie_id: int = 1
    selected_location: str = "Downtown Center"
    selected_date: str = "Hoy · Vie 29"
    selected_showtime: str = ""
    booking_step: int = 1
    seats: list[dict] = INIT_SEATS
    selected_seats: list[str] = []
    food_cart: list[dict] = FOOD_MENU_BASE
    card_name: str = ""
    card_number: str = ""
    card_expiry: str = ""
    card_cvv: str = ""
    reservation_code: str = ""

    # ── Hero ──────────────────────────────────────────────
    @rx.var
    def hero_titulo(self) -> str:
        return HERO_SLIDES[self.hero_index]["titulo"]

    @rx.var
    def hero_genero(self) -> str:
        return HERO_SLIDES[self.hero_index]["genero"]

    @rx.var
    def hero_clasificacion(self) -> str:
        return HERO_SLIDES[self.hero_index]["clasificacion"]

    @rx.var
    def hero_duracion(self) -> str:
        return HERO_SLIDES[self.hero_index]["duracion"]

    @rx.var
    def hero_emoji(self) -> str:
        return HERO_SLIDES[self.hero_index]["emoji"]

    @rx.var
    def hero_sinopsis_short(self) -> str:
        s = HERO_SLIDES[self.hero_index]["sinopsis"]
        return s[:110] + "..." if len(s) > 110 else s

    @rx.var
    def hero_bg(self) -> str:
        return HERO_SLIDES[self.hero_index]["bg_color"]

    @rx.var
    def hero_movie_id(self) -> int:
        return HERO_SLIDES[self.hero_index]["id"]

    # ── Current Movie ──────────────────────────────────────
    @rx.var
    def current_movie(self) -> dict:
        for p in PELICULAS:
            if p["id"] == self.movie_id:
                return p
        return PELICULAS[0]

    @rx.var
    def cm_titulo(self) -> str:
        return self.current_movie.get("titulo", "")

    @rx.var
    def cm_genero(self) -> str:
        return self.current_movie.get("genero", "")

    @rx.var
    def cm_clasificacion(self) -> str:
        return self.current_movie.get("clasificacion", "")

    @rx.var
    def cm_duracion(self) -> str:
        return self.current_movie.get("duracion", "")

    @rx.var
    def cm_director(self) -> str:
        return self.current_movie.get("director", "")

    @rx.var
    def cm_productor(self) -> str:
        return self.current_movie.get("productor", "")

    @rx.var
    def cm_reparto(self) -> str:
        return self.current_movie.get("reparto", "")

    @rx.var
    def cm_sinopsis(self) -> str:
        return self.current_movie.get("sinopsis", "")

    @rx.var
    def cm_emoji(self) -> str:
        return self.current_movie.get("emoji", "🎬")

    @rx.var
    def cm_bg(self) -> str:
        return self.current_movie.get("bg_color", "#0D0D0F")

    @rx.var
    def cm_precio_regular(self) -> int:
        return self.current_movie.get("precio_regular", 500)

    @rx.var
    def cm_precio_vip(self) -> int:
        return self.current_movie.get("precio_vip", 850)

    @rx.var
    def cm_fecha(self) -> str:
        return self.current_movie.get("fecha_estreno", "")

    @rx.var
    def cm_tab(self) -> str:
        return self.current_movie.get("tab", "cartelera")

    @rx.var
    def cm_funciones_loc(self) -> list[str]:
        funciones = self.current_movie.get("funciones", {})
        return funciones.get(self.selected_location, [])

    # ── Lists ──────────────────────────────────────────────
    @rx.var
    def cartelera_movies(self) -> list[dict]:
        return [p for p in PELICULAS if p["tab"] == "cartelera"]

    @rx.var
    def pronto_movies(self) -> list[dict]:
        return [p for p in PELICULAS if p["tab"] == "pronto"]

    # ── Booking Totals ─────────────────────────────────────
    @rx.var
    def total_boletos(self) -> int:
        total = 0
        for sid in self.selected_seats:
            for seat in self.seats:
                if seat["id"] == sid:
                    price = self.cm_precio_vip if seat["tipo"] == "vip" else self.cm_precio_regular
                    total += price
                    break
        return total

    @rx.var
    def total_comida(self) -> int:
        return sum(item["precio"] * item.get("qty", 0) for item in self.food_cart)

    @rx.var
    def cargo_servicio(self) -> int:
        return len(self.selected_seats) * SERVICE_FEE

    @rx.var
    def gran_total(self) -> int:
        return self.total_boletos + self.total_comida + self.cargo_servicio

    @rx.var
    def num_asientos(self) -> int:
        return len(self.selected_seats)

    @rx.var
    def food_selected(self) -> list[dict]:
        return [item for item in self.food_cart if item.get("qty", 0) > 0]

    @rx.var
    def asientos_display(self) -> str:
        return ", ".join(self.selected_seats) if self.selected_seats else "Ninguno"

    @rx.var
    def can_proceed(self) -> bool:
        return len(self.selected_seats) > 0

    # ── Row slices for seat map ────────────────────────────
    @rx.var
    def row_A(self) -> list[dict]:
        return self.seats[0:15]

    @rx.var
    def row_B(self) -> list[dict]:
        return self.seats[15:30]

    @rx.var
    def row_C(self) -> list[dict]:
        return self.seats[30:45]

    @rx.var
    def row_D(self) -> list[dict]:
        return self.seats[45:60]

    @rx.var
    def row_E(self) -> list[dict]:
        return self.seats[60:75]

    @rx.var
    def row_F(self) -> list[dict]:
        return self.seats[75:90]

    @rx.var
    def row_G(self) -> list[dict]:
        return self.seats[90:105]

    @rx.var
    def row_H(self) -> list[dict]:
        return self.seats[105:120]

    @rx.var
    def row_I(self) -> list[dict]:
        return self.seats[120:135]

    @rx.var
    def row_J(self) -> list[dict]:
        return self.seats[135:150]

    @rx.var
    def row_K(self) -> list[dict]:
        return self.seats[150:165]

    @rx.var
    def row_L(self) -> list[dict]:
        return self.seats[165:180]

    @rx.var
    def row_M(self) -> list[dict]:
        return self.seats[180:195]

    @rx.var
    def row_N(self) -> list[dict]:
        return self.seats[195:210]

    # ── Events: Hero ───────────────────────────────────────
    def next_hero(self):
        self.hero_index = (self.hero_index + 1) % len(HERO_SLIDES)

    def prev_hero(self):
        self.hero_index = (self.hero_index - 1) % len(HERO_SLIDES)

    def go_to_slide(self, idx: int):
        self.hero_index = idx

    # ── Events: Home ───────────────────────────────────────
    def set_tab(self, tab: str):
        self.active_tab = tab

    # ── Events: Navigation ─────────────────────────────────
    def go_to_movie(self, movie_id: int):
        self.movie_id = movie_id
        self.selected_showtime = ""
        self.selected_location = "Downtown Center"
        return rx.redirect("/pelicula")

    def go_home(self):
        return rx.redirect("/")

    def go_back_to_movie(self):
        return rx.redirect("/pelicula")

    # ── Events: Movie Detail ───────────────────────────────
    def set_location(self, location: str):
        self.selected_location = location
        self.selected_showtime = ""

    def set_date(self, date: str):
        self.selected_date = date
        self.selected_showtime = ""

    def set_showtime(self, time: str):
        self.selected_showtime = time

    def start_booking(self):
        if not self.selected_showtime:
            return
        self.booking_step = 1
        self.selected_seats = []
        self.food_cart = [dict(item) for item in FOOD_MENU_BASE]
        self.seats = [dict(s) for s in INIT_SEATS]
        return rx.redirect("/reservar")

    # ── Events: Booking ────────────────────────────────────
    def toggle_seat(self, seat_id: str):
        for seat in self.seats:
            if seat["id"] == seat_id and seat["estado"] == "reservado":
                return
        if seat_id in self.selected_seats:
            self.selected_seats = [s for s in self.selected_seats if s != seat_id]
        else:
            if len(self.selected_seats) < 8:
                self.selected_seats = self.selected_seats + [seat_id]

    def next_step(self):
        if self.booking_step == 1 and not self.selected_seats:
            return
        if self.booking_step < 4:
            self.booking_step += 1

    def prev_step(self):
        if self.booking_step > 1:
            self.booking_step -= 1

    def go_step(self, step: int):
        if step <= self.booking_step:
            self.booking_step = step

    def add_food(self, fid: str):
        self.food_cart = [
            {**item, "qty": item.get("qty", 0) + 1}
            if item["id"] == fid else item
            for item in self.food_cart
        ]

    def remove_food(self, fid: str):
        self.food_cart = [
            {**item, "qty": max(0, item.get("qty", 0) - 1)}
            if item["id"] == fid else item
            for item in self.food_cart
        ]

    def set_card_name(self, v: str):
        self.card_name = v

    def set_card_number(self, v: str):
        self.card_number = v

    def set_card_expiry(self, v: str):
        self.card_expiry = v

    def set_card_cvv(self, v: str):
        self.card_cvv = v

    def confirm_payment(self):
        import random
        self.reservation_code = f"CXC-{2025}-{random.randint(100000, 999999)}"
        self.booking_step = 5


# ═══════════════════════════════════════════════════════════════
#  UI COMPONENTS
# ═══════════════════════════════════════════════════════════════

def page_style() -> rx.Component:
    return rx.el.style(f"""
        @import url('{GFONTS}');
        html {{ scroll-behavior: smooth; }}
        body {{ margin: 0; padding: 0; background: #0D0D0F; }}
        * {{ box-sizing: border-box; }}
    """)


# ─── Navbar ──────────────────────────────────────────────────
def navbar() -> rx.Component:
    return rx.box(
        rx.hstack(
            rx.link(
                rx.hstack(
                    rx.text("🎬", font_size="22px", line_height="1"),
                    rx.text("CineMax", class_name="logo-text"),
                    spacing="2", align="center",
                ),
                href="/", text_decoration="none",
            ),
            rx.spacer(),
            rx.hstack(
                rx.link("Cartelera", href="/", class_name="nav-link"),
                rx.link("Próximamente", href="/", class_name="nav-link"),
                rx.link("Promociones", href="#", class_name="nav-link"),
                rx.link("Concesiones", href="#", class_name="nav-link"),
                spacing="8",
            ),
            rx.spacer(),
            rx.hstack(
                rx.button(
                    "🔍",
                    class_name="icon-btn",
                    background="transparent", border="none",
                    color="white", cursor="pointer", font_size="18px", padding="8px",
                ),
                rx.button("SIGN IN", class_name="btn-signin"),
                spacing="3", align="center",
            ),
            align="center", width="100%",
        ),
        class_name="navbar",
    )


# ─── Hero Carousel ───────────────────────────────────────────
def hero_dot(idx: int) -> rx.Component:
    return rx.box(
        class_name=rx.cond(
            State.hero_index == idx, "hero-dot hero-dot-active", "hero-dot"
        ),
        on_click=State.go_to_slide(idx),
        cursor="pointer",
    )


def hero_section() -> rx.Component:
    return rx.box(
        # Dynamic gradient background
        rx.box(
            style={"background": State.hero_bg},
            class_name="hero-bg-layer",
        ),
        # Cinematic grid overlay
        rx.box(class_name="hero-grid"),
        # Red vignette overlay
        rx.box(class_name="hero-vignette"),
        # Gradient bottom fade
        rx.box(class_name="hero-fade"),
        # Giant decorative emoji
        rx.box(
            rx.text(State.hero_emoji, class_name="hero-emoji-bg"),
            class_name="hero-emoji-container",
        ),
        # Left Arrow
        rx.button(
            "‹",
            class_name="hero-arrow hero-arrow-left",
            on_click=State.prev_hero,
        ),
        # Right Arrow
        rx.button(
            "›",
            class_name="hero-arrow hero-arrow-right",
            on_click=State.next_hero,
        ),
        # Content
        rx.box(
            rx.box(
                rx.text(State.hero_genero, class_name="hero-genre-tag"),
                class_name="hero-badge-wrap",
            ),
            rx.heading(State.hero_titulo, class_name="hero-title"),
            rx.text(State.hero_sinopsis_short, class_name="hero-subtitle"),
            rx.hstack(
                rx.text(State.hero_clasificacion, class_name="hero-meta-badge"),
                rx.text("·", color="#555", font_size="18px"),
                rx.text(State.hero_duracion, class_name="hero-meta-text"),
                spacing="2", align="center", margin_bottom="28px",
            ),
            rx.hstack(
                rx.button(
                    "Comprar Boletos",
                    class_name="btn-primary-lg",
                    on_click=State.go_to_movie(State.hero_movie_id),
                ),
                rx.button("▶  Ver Tráiler", class_name="btn-secondary-lg"),
                spacing="4",
            ),
            # Dot navigation
            rx.hstack(
                *[hero_dot(i) for i in range(len(HERO_SLIDES))],
                spacing="2",
                margin_top="44px",
            ),
            class_name="hero-content",
        ),
        class_name="hero-section",
    )


# ─── Movie Cards ─────────────────────────────────────────────
def movie_card_cartelera(p: dict) -> rx.Component:
    return rx.box(
        # Poster area
        rx.box(
            rx.box(
                style={"background": p["bg_color"]},
                class_name="poster-bg",
            ),
            rx.box(class_name="poster-shimmer"),
            rx.text(p["emoji"], class_name="poster-emoji"),
            rx.box(
                rx.text(p["clasificacion"], class_name="poster-rating"),
                class_name="poster-rating-wrap",
            ),
            rx.box(class_name="poster-gradient"),
            class_name="movie-poster",
        ),
        # Info area
        rx.box(
            rx.hstack(
                rx.text(p["genero"], class_name="card-genre"),
                rx.spacer(),
                rx.text(p["duracion"], class_name="card-duration"),
                align="center",
            ),
            rx.text(p["titulo"], class_name="card-title"),
            rx.button(
                "Ver Funciones",
                class_name="btn-card",
                on_click=State.go_to_movie(p["id"]),
                width="100%",
            ),
            class_name="movie-info",
        ),
        class_name="movie-card",
        on_click=State.go_to_movie(p["id"]),
    )


def movie_card_pronto(p: dict) -> rx.Component:
    return rx.box(
        rx.box(
            rx.box(
                style={"background": p["bg_color"]},
                class_name="poster-bg",
            ),
            rx.box(class_name="poster-shimmer"),
            rx.text(p["emoji"], class_name="poster-emoji"),
