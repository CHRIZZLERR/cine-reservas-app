# ─── Tabs + Movie Grid Section ───────────────────────────────
def movies_section() -> rx.Component:
    return rx.box(
        rx.box(
            # Section header
            rx.hstack(
                rx.box(
                    rx.hstack(
                        rx.button(
                            "En Cartelera",
                            class_name=rx.cond(
                                State.active_tab == "cartelera", "tab-btn tab-active", "tab-btn"
                            ),
                            on_click=State.set_tab("cartelera"),
                        ),
                        rx.button(
                            "Próximamente",
                            class_name=rx.cond(
                                State.active_tab == "pronto", "tab-btn tab-active", "tab-btn"
                            ),
                            on_click=State.set_tab("pronto"),
                        ),
                        spacing="0",
                        class_name="tabs-row",
                    ),
                ),
                rx.spacer(),
                rx.link("Ver Todo →", href="#", class_name="view-all"),
                align="center",
                margin_bottom="32px",
            ),
            # Movie grid — cartelera
            rx.cond(
                State.active_tab == "cartelera",
                rx.grid(
                    rx.foreach(State.cartelera_movies, movie_card_cartelera),
                    columns="6",
                    spacing="5",
                    width="100%",
                ),
                # pronto
                rx.grid(
                    rx.foreach(State.pronto_movies, movie_card_pronto),
                    columns="6",
                    spacing="5",
                    width="100%",
                ),
            ),
            class_name="section",
        ),
        background="#0D0D0F",
    )


# ─── Coming Soon Strip ───────────────────────────────────────
def coming_strip_card(p: dict) -> rx.Component:
