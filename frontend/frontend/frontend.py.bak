# ─── Footer ──────────────────────────────────────────────────
def footer() -> rx.Component:
    col_links = {
        "Películas": ["En Cartelera", "Próximamente", "Internacional", "IMAX", "3D"],
        "Cines": ["Downtown Center", "Galería 360", "Ágora Mall", "Blue Mall"],
        "Nosotros": ["Sobre CineMax", "Empleos", "Prensa", "Contacto"],
        "Ayuda": ["FAQ", "Devoluciones", "Accesibilidad", "Términos", "Privacidad"],
    }
    return rx.box(
        rx.box(
            rx.grid(
                # Brand col
                rx.vstack(
                    rx.hstack(
                        rx.text("🎬", font_size="24px"),
                        rx.text("CineMax", class_name="footer-brand"),
                        spacing="2", align="center",
                    ),
                    rx.text(
                        "La mejor experiencia cinematográfica de República Dominicana. Donde el cine cobra vida.",
                        class_name="footer-desc",
                    ),
                    rx.hstack(
                        *[
                            rx.box(
                                rx.text(icon, font_size="16px"),
                                class_name="social-btn",
                                cursor="pointer",
                            )
                            for icon in ["📘", "📷", "🐦", "▶️"]
                        ],
                        spacing="2",
                    ),
                    align_items="start",
                    spacing="4",
                ),
                # Link cols
                *[
                    rx.vstack(
                        rx.text(title, class_name="footer-col-title"),
                        *[
                            rx.link(link, href="#", class_name="footer-link")
                            for link in links
                        ],
                        align_items="start",
                        spacing="2",
                    )
                    for title, links in col_links.items()
                ],
                columns="5",
                spacing="8",
                margin_bottom="48px",
            ),
            rx.box(class_name="footer-divider"),
            rx.hstack(
                rx.text("© 2025 CineMax · Todos los derechos reservados · República Dominicana", class_name="footer-copy"),
                rx.spacer(),
                rx.hstack(
                    rx.link("Términos", href="#", class_name="footer-legal-link"),
                    rx.link("Privacidad", href="#", class_name="footer-legal-link"),
                    rx.link("Cookies", href="#", class_name="footer-legal-link"),
                    spacing="6",
                ),
                align="center",
            ),
            class_name="section",
        ),
        class_name="footer",
    )


